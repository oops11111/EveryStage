<Project>
  <!-- The one version source for every EveryStage assembly, the installer and the about page.
       Scripts and CI only read it (scripts/Build-Installer.*); bump it here for each release.
       InformationalVersion gets "+<commit>" from SourceRevisionId, which CI and the build scripts pass in. -->
  <PropertyGroup>
    <EveryStageVersion>0.9.1</EveryStageVersion>
    <Version>$(EveryStageVersion)</Version>
    <SourceRevisionId Condition="'$(SourceRevisionId)' == '' and '$(GITHUB_SHA)' != ''">$(GITHUB_SHA)</SourceRevisionId>
  </PropertyGroup>
</Project>
