<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>EveryStage.Caster</AssemblyName>
    <RootNamespace>EveryStage.Caster</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\EveryStage.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The LAN discovery/pairing wire format, shared with EveryStage.Terminal so both sides
         always agree on it by construction. -->
    <ProjectReference Include="..\..\Shared\EveryStage.Discovery\EveryStage.Discovery.csproj" />
    <!-- Shares D3D11Device with the Terminal/Phase-0-demo side for device-creation boilerplate.
         Capture/ScreenCaptureSource.cs uses it for IDXGIOutput1.DuplicateOutput; Encode/ uses its
         video-processor path (Capture's BGRA -> NV12 conversion) and its IMFDXGIDeviceManager
         (bound to the H.264 encoder MFT so it can consume D3D11 textures directly). -->
    <ProjectReference Include="..\..\Shared\EveryStage.Rendering\EveryStage.Rendering.csproj" />
    <!-- RTP packet framing / H.264 payload packetization. -->
    <ProjectReference Include="..\..\Shared\EveryStage.Transport\EveryStage.Transport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Encode/H264HardwareEncoder.cs drives the H.264 encoder MFT directly (IMFTransform,
         MFTEnumEx, ICodecAPI) rather than through EveryStage.Rendering's higher-level source-reader
         usage, so it references Vortice.MediaFoundation explicitly rather than relying on it
         flowing in transitively through the EveryStage.Rendering project reference. -->
    <PackageReference Include="Vortice.MediaFoundation" Version="3.6.2" />
    <!-- Capture/AudioCaptureSource.cs drives NAudio's WasapiLoopbackCapture directly for system-
         audio capture, so it references NAudio explicitly rather than relying on it flowing in
         transitively through the EveryStage.Rendering project reference (same reasoning as
         Vortice.MediaFoundation above). -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
