<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>EveryStage.Caster</AssemblyName>
    <RootNamespace>EveryStage.Caster</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- The LAN discovery/pairing wire format, shared with EveryStage.Terminal so both sides
         always agree on it by construction. -->
    <ProjectReference Include="..\..\Shared\EveryStage.Discovery\EveryStage.Discovery.csproj" />
    <!-- Shares D3D11Device with the Terminal/Phase-0-demo side purely for the device-creation
         boilerplate (Capture/ScreenCaptureSource.cs needs an ID3D11Device to call
         IDXGIOutput1.DuplicateOutput against) — Caster doesn't touch the MF/video-processor half
         of that library, only the device setup. -->
    <ProjectReference Include="..\..\Shared\EveryStage.Rendering\EveryStage.Rendering.csproj" />
    <!-- RTP packet framing / H.264 payload packetization — not driving real encoded video yet
         (see TransportSelfTest), but exercised here as a loopback self-test alongside the screen
         capture one. -->
    <ProjectReference Include="..\..\Shared\EveryStage.Transport\EveryStage.Transport.csproj" />
  </ItemGroup>

</Project>
