<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- No Windows-specific API surface (just System.Text.Json + sockets, used identically by
         Terminal and Caster) -- plain net8.0 rather than a -windows TFM, unlike the rest of this
         solution, so this library doesn't pull in a Windows SDK workload requirement of its own. -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <RootNamespace>EveryStage.Discovery</RootNamespace>
  </PropertyGroup>

</Project>
