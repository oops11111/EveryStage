<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>EveryStage.Terminal</AssemblyName>
    <RootNamespace>EveryStage.Terminal</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core Audio session enumeration/mute for the audio-takeover behavior in PLANNING.md §9.3. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!--
      PDF rendering (PLANNING.md §3 "PDF(PDFium)"). PdfiumViewer wraps native pdfium.dll; it needs
      a companion native-binary package for the target architecture (historically
      "PdfiumViewer.Native.x86_64.v8-xfa" or similar — the exact current package name/version
      should be confirmed on nuget.org when first restoring on Windows, since this hasn't been
      restored/verified in this sandbox).
    -->
    <PackageReference Include="PdfiumViewer" Version="2.13.0" />
    <PackageReference Include="PdfiumViewer.Native.x86_64.v8-xfa" Version="2018.4.8.256" />
  </ItemGroup>

  <ItemGroup>
    <!-- The zero-copy D3D11/Media Foundation video pipeline (see VideoContentController), shared
         with the Phase 0 validation demo. -->
    <ProjectReference Include="..\..\Shared\EveryStage.Rendering\EveryStage.Rendering.csproj" />
    <!-- The LAN discovery/pairing wire format, shared with EveryStage.Caster so both sides always
         agree on it by construction. -->
    <ProjectReference Include="..\..\Shared\EveryStage.Discovery\EveryStage.Discovery.csproj" />
  </ItemGroup>

</Project>
