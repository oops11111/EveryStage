<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>EveryStage.Terminal</AssemblyName>
    <RootNamespace>EveryStage.Terminal</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\EveryStage.ico</ApplicationIcon>
    <!-- PdfiumViewer 2.13 only ships .NET Framework assets, but is intentionally used through its
         WinForms API on this Windows-only target. Keep the compatibility warning documented here
         without making every warnings-as-errors CI build fail on the known package shape. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core Audio session enumeration/mute for the audio-takeover behavior in PLANNING.md §9.3. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!--
      PDF rendering (PLANNING.md §3 "PDF(PDFium)"). PdfiumViewer wraps native pdfium.dll; it needs
      a companion native-binary package for the target architecture (historically
      "PdfiumViewer.Native.x86_64.v8-xfa" or similar — the exact current package name/version
      should be confirmed on nuget.org when first restoring on Windows, since this hasn't been
      restored/verified in this sandbox).
    -->
    <PackageReference Include="PdfiumViewer" Version="2.13.0" />
    <PackageReference Include="PdfiumViewer.Native.x86_64.v8-xfa" Version="2018.4.8.256" />
    <!-- ContentEngine/WpsDocumentController.cs's entire-call `dynamic` COM automation (PLANNING.md
         §14.1's WPS COM互操作) — same reason EveryStage.Rendering.csproj needed this for
         AudioDecodeSource's own dynamic Media Foundation calls: `dynamic` needs this package
         explicitly on .NET (unlike classic .NET Framework, where it shipped in mscorlib). Version
         matches the one already used elsewhere in this repo (Poc/WpsComInteropSpike.csproj,
         EveryStage.Rendering.csproj). -->
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The zero-copy D3D11/Media Foundation video pipeline (see VideoContentController), shared
         with the Phase 0 validation demo. Receiving/CastReceiver.cs also reuses SwapChainPresenter
         to present the live cast decoder's output, the same way VideoContentController does for
         local file playback. -->
    <ProjectReference Include="..\..\Shared\EveryStage.Rendering\EveryStage.Rendering.csproj" />
    <!-- The LAN discovery/pairing wire format, shared with EveryStage.Caster so both sides always
         agree on it by construction. -->
    <ProjectReference Include="..\..\Shared\EveryStage.Discovery\EveryStage.Discovery.csproj" />
    <!-- RTP packet framing / H.264 payload depacketization — Receiving/CastReceiver.cs is this
         project's first consumer of RtpReceiver (previously only exercised by Caster's transport
         self-test). -->
    <ProjectReference Include="..\..\Shared\EveryStage.Transport\EveryStage.Transport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Receiving/H264HardwareDecoder.cs drives the H.264 decoder MFT directly (IMFTransform,
         MFTEnumEx) rather than through EveryStage.Rendering's higher-level source-reader usage, so
         it references Vortice.MediaFoundation explicitly rather than relying on it flowing in
         transitively through the EveryStage.Rendering project reference — same reasoning as
         EveryStage.Caster's H264HardwareEncoder.cs. -->
    <PackageReference Include="Vortice.MediaFoundation" Version="3.6.2" />
  </ItemGroup>

</Project>
