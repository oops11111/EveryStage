<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows 10 SDK contract needed for DXGI 1.5 / D3D11.3 and current WinRT-free MF interop -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ZeroCopyRenderDemo</AssemblyName>
    <RootNamespace>EveryStage.Poc.ZeroCopyRenderDemo</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The actual D3D11/MF decode+render pipeline lives in EveryStage.Rendering, shared with the
         real Terminal video renderer — this demo only supplies the window, scheduling loop, and
         metrics instrumentation around it. -->
    <ProjectReference Include="..\..\Shared\EveryStage.Rendering\EveryStage.Rendering.csproj" />
  </ItemGroup>

</Project>
